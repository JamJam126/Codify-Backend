# ═══════════════════════════════════════════════════════
# Codify Evaluator — Environment Configuration (V1)
# Copy to .env and fill values
# ═══════════════════════════════════════════════════════

# ── LLM CONFIG ─────────────────────────────────────────

LLM_PROVIDER=groq
LLM_MODEL=moonshotai/kimi-k2-instruct

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_RESPONSE_FORMAT=json_object

# ── API KEYS ───────────────────────────────────────────

GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
ZHIPU_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=

# ── VECTOR DB (RAG) ───────────────────────────────────

VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333

# (optional if using local storage alternative)
CHROMA_DB_PATH=./data/chroma

# ── RETRY / STABILITY ─────────────────────────────────

LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_SECONDS=20

# ── APP CONFIG ───────────────────────────────────────

APP_ENV=development
LOG_LEVEL=INFO